    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModularMonolith.Modules.Identity.Presentation\ModularMonolith.Modules.Identity.Presentation.csproj" />
